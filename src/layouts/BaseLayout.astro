---
/**
 * Document shell for every page: head and SEO, self-hosted font, global styles, skip link
 * and header. Pages add page-specific head tags (e.g. an LCP preload) via the `head` slot.
 */
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import Seo from '@/components/seo/Seo.astro';
import '@/styles/global.css';

type Props = ComponentProps<typeof Seo>;

const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-devanagari" />
    <Font cssVariable="--font-plex-mono" />
    <slot name="head" />
  </head>
  <body class="bg-white font-sans text-ink-900 antialiased">
    <a
      href="#main"
      class="sr-only rounded-full bg-navy-900 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-3"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
