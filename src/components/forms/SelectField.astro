---
/** Native select styled to match TextField. Native keeps the phone's own picker on mobile. */
import FieldError from '@/components/forms/FieldError.astro';
import FieldLabel from '@/components/forms/FieldLabel.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  name: string;
  label: string;
  placeholder: string;
  options: readonly { value: string; label: string }[];
  isRequired?: boolean;
  autocomplete?: 'address-level1';
}

const { name, label, placeholder, options, isRequired = false, autocomplete } = Astro.props;
const id = `field-${name}`;
const errorId = `${id}-error`;
---

<div>
  <FieldLabel for={id} label={label} isRequired={isRequired} />
  <div class="relative mt-2 rounded-xl border border-ink-300 bg-white transition-colors hover:border-ink-500 focus-within:border-navy-900 focus-within:ring-1 focus-within:ring-navy-900 has-aria-invalid:border-brand-700 has-aria-invalid:ring-1 has-aria-invalid:ring-brand-700 motion-reduce:transition-none">
    <select
      id={id}
      name={name}
      required={isRequired}
      autocomplete={autocomplete}
      aria-describedby={errorId}
      class="h-12 w-full cursor-pointer appearance-none bg-transparent pr-10 pl-3.5 text-base text-navy-900 focus:outline-none"
    >
      <option value="">{placeholder}</option>
      {options.map(({ value, label: optionLabel }) => (
        <option value={value}>{optionLabel}</option>
      ))}
    </select>
    <Icon
      name="chevron-down"
      class="pointer-events-none absolute top-1/2 right-3.5 size-4 -translate-y-1/2 text-ink-500"
    />
  </div>
  <FieldError id={errorId} name={name} />
</div>
