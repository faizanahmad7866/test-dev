---
/**
 * One numbered part of a long form: a step badge, the title and its Hindi label, then a
 * two-column field grid. Steps are separated by space, not rules.
 */
interface Props {
  step: number;
  title: string;
  titleHi: string;
}

const { step, title, titleHi } = Astro.props;
const headingId = `form-step-${step}`;
---

<section aria-labelledby={headingId}>
  <div class="flex items-center gap-3">
    <span
      class="grid size-8 shrink-0 place-items-center rounded-full bg-navy-900 text-sm font-bold text-white tabular-nums"
      aria-hidden="true"
    >
      {step}
    </span>
    <h3 id={headingId} class="text-xl font-bold text-navy-900">
      <span class="sr-only">{`Step ${step}: `}</span>
      {title}{' '}
      <span lang="hi" class="ml-1 text-base font-medium text-ink-500">
        {titleHi}
      </span>
    </h3>
  </div>
  <div class="mt-6 grid gap-x-6 gap-y-6 sm:grid-cols-2">
    <slot />
  </div>
</section>
