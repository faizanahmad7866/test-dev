---
/**
 * A question answered by ticking options: radios for one answer, checkboxes for many.
 * Native controls in rounded option cards; the chosen card turns navy-edged. The whole card
 * is the label, so it is an easy tap target.
 */
import FieldError from '@/components/forms/FieldError.astro';

interface Choice {
  value: string;
  label: string;
  description?: string;
}

interface Props {
  name: string;
  legend: string;
  type: 'radio' | 'checkbox';
  options: readonly Choice[];
  isRequired?: boolean;
  columns?: 2 | 3;
}

const { name, legend, type, options, isRequired = false, columns = 2 } = Astro.props;
const errorId = `field-${name}-error`;
---

<fieldset aria-describedby={errorId} class="group/choices sm:col-span-2">
  <legend class="text-sm font-semibold text-navy-900">
    {legend}
    {isRequired && (
      <span class="ml-0.5 text-brand-700" aria-hidden="true">
        *
      </span>
    )}
  </legend>
  <div
    class:list={[
      'mt-2 grid gap-3',
      columns === 3 ? 'grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2',
    ]}
  >
    {options.map((option) => (
      <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-ink-300 bg-white px-3.5 py-3.5 sm:px-4 transition-colors select-none group-has-aria-invalid/choices:border-brand-700 hover:border-ink-500 has-checked:border-navy-900 has-checked:bg-mist-50 has-checked:ring-1 has-checked:ring-navy-900 motion-reduce:transition-none">
        <input
          type={type}
          name={name}
          value={option.value}
          required={type === 'radio' && isRequired}
          class="mt-0.5 size-4 shrink-0 cursor-pointer accent-navy-900"
        />
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-navy-900">{option.label}</span>
          {option.description && (
            <span class="mt-0.5 block text-xs text-ink-600">{option.description}</span>
          )}
        </span>
      </label>
    ))}
  </div>
  <FieldError id={errorId} name={name} />
</fieldset>
