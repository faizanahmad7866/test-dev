---
/**
 * A question answered by tapping cards: radios for one answer, checkboxes for many.
 * Real inputs sit inside each card (visually hidden), so keyboard and screen readers
 * get native radio/checkbox behaviour and the card only restyles the checked state.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FieldError from '@/components/forms/FieldError.astro';
import Icon from '@/components/ui/Icon.astro';

interface Choice {
  value: string;
  label: string;
  description?: string;
  image?: ImageMetadata | undefined;
}

interface Props {
  name: string;
  legend: string;
  type: 'radio' | 'checkbox';
  options: readonly Choice[];
  isRequired?: boolean;
  columns?: 2 | 3;
}

const { name, legend, type, options, isRequired = false, columns = 2 } = Astro.props;
const errorId = `field-${name}-error`;
---

<fieldset aria-describedby={errorId} class="sm:col-span-2">
  <legend class="text-sm font-semibold text-navy-900">
    {legend}
    {isRequired && (
      <span class="ml-0.5 text-brand-700" aria-hidden="true">
        *
      </span>
    )}
  </legend>
  <div
    class:list={[
      'mt-3 grid gap-3',
      columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2',
    ]}
  >
    {options.map((option) => (
      <label class="group flex cursor-pointer items-center gap-3 rounded-2xl bg-white p-4 ring-1 ring-ink-300 transition select-none hover:ring-ink-500 has-checked:bg-navy-50 has-checked:ring-2 has-checked:ring-navy-900 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ocean-600 has-aria-invalid:ring-brand-700 motion-reduce:transition-none">
        <input
          type={type}
          name={name}
          value={option.value}
          required={type === 'radio' && isRequired}
          class="sr-only"
        />
        {option.image && (
          <Image
            src={option.image}
            alt=""
            widths={[56, 112]}
            sizes="56px"
            class="size-14 shrink-0 rounded-xl bg-mist-100 object-contain p-1"
          />
        )}
        <span class="min-w-0 flex-1">
          <span class="block text-sm font-bold text-navy-900">{option.label}</span>
          {option.description && (
            <span class="mt-0.5 block text-xs text-ink-500">{option.description}</span>
          )}
        </span>
        <span
          class:list={[
            'grid size-5 shrink-0 place-items-center border border-ink-300 bg-white text-transparent transition-colors group-has-checked:border-navy-900 group-has-checked:bg-navy-900 group-has-checked:text-white motion-reduce:transition-none',
            type === 'radio' ? 'rounded-full' : 'rounded-md',
          ]}
        >
          <Icon name="check" class="size-3.5" />
        </span>
      </label>
    ))}
  </div>
  <FieldError id={errorId} name={name} />
</fieldset>
