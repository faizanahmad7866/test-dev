---
/**
 * Catalogue cover: the Dinar logo on white, then the range photograph in its own studio
 * colours under the title, three facts a dealer looks for first, and the parent company with
 * the website at the foot.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/dinar-logo.png';
import rangeStudio from '@/assets/brand/dinar-range-studio.jpg';
import Sheet from '@/components/catalogue/Sheet.astro';
import CompanyLogo from '@/components/layout/CompanyLogo.astro';
import { site } from '@/config/site';
import { formatMrp } from '@/lib/format-mrp';
import { formatPhone } from '@/lib/format-phone';
import type { ProductSku } from '@/lib/product-skus';

interface Props {
  skus: ProductSku[];
  productCount: number;
  edition: string;
}

const { skus, productCount, edition } = Astro.props;
const lowestMrp = Math.min(...skus.map(({ variant }) => variant.mrp));
const facts = [
  { value: `${skus.length} packs`, note: `across ${productCount} products` },
  { value: `MRP from ${formatMrp(lowestMrp)}`, note: 'inclusive of all taxes' },
  {
    value: `Made in ${site.company.office.locality}`,
    note: `${site.company.office.region}, India`,
  },
];
---

<Sheet bare>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between px-12 pt-10 pb-8">
      <Image src={logo} alt={site.name} widths={[160, 320]} sizes="160px" class="h-20 w-auto" />
      <p class="text-right text-sm leading-6 text-ink-500">
        <span class="block font-bold text-navy-900">Product Catalogue</span>
        {edition}
      </p>
    </div>

    <div class="bg-studio flex flex-1 flex-col">
      <div class="px-12 pt-12">
        <p class="text-sm font-bold tracking-wide text-brand-700 uppercase">
          Product Catalogue{' '}
          <span lang="hi" class="ml-1 font-semibold tracking-normal normal-case">
            उत्पाद सूची
          </span>
        </p>
        <h1 class="mt-3 text-6xl font-bold tracking-tight text-navy-900">The Dinar range</h1>
        <p class="mt-4 max-w-md text-xl leading-8 text-ink-700">{site.tagline}</p>
      </div>
      <Image
        src={rangeStudio}
        alt="The Dinar range: two Detergent Powder packs, Super Wash and Detergent Cake"
        widths={[1600]}
        sizes="794px"
        format="jpg"
        quality={82}
        class="mt-auto h-auto w-full"
      />
    </div>

    <dl class="grid grid-cols-3 gap-6 px-12 pt-8">
      {facts.map(({ value, note }) => (
        <div>
          <dt class="sr-only">{note}</dt>
          <dd>
            <span class="block text-xl font-bold text-navy-900">{value}</span>
            <span class="mt-1 block text-sm text-ink-600">{note}</span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="flex items-end justify-between px-12 pt-8 pb-10">
      <div>
        <p class="text-xs font-semibold tracking-wide text-ink-500 uppercase">A brand of</p>
        <CompanyLogo size="md" class="mt-2" />
      </div>
      <p class="text-right">
        <span class="block text-2xl font-bold text-navy-900">{new URL(site.url).host}</span>
        <span class="mt-1 block text-sm text-ink-600 tabular-nums">
          Helpline {formatPhone(site.supportPhone)}
        </span>
      </p>
    </div>
  </div>
</Sheet>
