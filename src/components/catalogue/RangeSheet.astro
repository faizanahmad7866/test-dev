---
/**
 * Page two, the catalogue's menu: who Dinar is, the five promises as round photo badges, and
 * "Range at a glance", every pack with its size, pack, MRP and the page it is on.
 */
import { Image } from 'astro:assets';
import Sheet from '@/components/catalogue/Sheet.astro';
import { site } from '@/config/site';
import { BRAND_PROMISES } from '@/data/brand-promises';
import { formatMrp } from '@/lib/format-mrp';
import { packPhotoFit } from '@/lib/pack-photo';
import type { ProductSku } from '@/lib/product-skus';

interface Props {
  skus: ProductSku[];
  /** Product id → the page its overview starts on. */
  pageOf: Record<string, number>;
  alsoPackedIn: { name: string; sizes: string[] }[];
  page: number;
  total: number;
  edition: string;
}

const { skus, pageOf, alsoPackedIn, page, total, edition } = Astro.props;
const ZOOM = { none: '', center: 'scale-125', top: 'scale-125 origin-top' } as const;
---

<Sheet page={page} total={total} edition={edition}>
  <div class="grid grid-cols-12 gap-8">
    <div class="col-span-7">
      <p class="text-sm font-bold tracking-wide text-brand-700 uppercase">About Dinar</p>
      <h2 class="mt-2 text-4xl font-bold tracking-tight text-navy-900">{site.tagline}</h2>
    </div>
    <p class="col-span-5 self-end leading-7 text-ink-700">
      Dinar makes detergent powder and detergent cake for everyday family laundry. Every pack is
      made and marketed by {site.company.legalName}, {site.company.office.locality},{' '}
      {site.company.office.region}.
    </p>
  </div>

  <h3 class="mt-10 text-lg font-bold text-navy-900">Why choose Dinar</h3>
  <ul class="mt-5 grid grid-cols-5 gap-4">
    {BRAND_PROMISES.map(({ en, hi, image, zoom }) => (
      <li class="text-center">
        <div class="mx-auto size-20 overflow-hidden rounded-full bg-white ring-4 ring-ink-100">
          <Image
            src={image}
            alt=""
            widths={[160]}
            sizes="80px"
            format="jpg"
            class:list={['size-full object-cover', ZOOM[zoom]]}
          />
        </div>
        <p class="mt-3 text-sm leading-snug font-bold text-navy-900">{en}</p>
        <p lang="hi" class="mt-1 text-xs text-ink-600">
          {hi}
        </p>
      </li>
    ))}
  </ul>

  <h3 class="mt-12 text-lg font-bold text-navy-900">
    Range at a glance{' '}
    <span lang="hi" class="ml-1 text-sm font-medium text-ink-500">
      उत्पाद और MRP
    </span>
  </h3>
  <table class="mt-4 w-full overflow-hidden rounded-2xl bg-ink-50 text-left text-sm">
    <thead class="bg-navy-900 text-white">
      <tr>
        <th scope="col" class="py-3 pl-5 font-semibold">
          Product
        </th>
        <th scope="col" class="py-3 font-semibold">
          Size
        </th>
        <th scope="col" class="py-3 font-semibold">
          Pack
        </th>
        <th scope="col" class="py-3 text-right font-semibold">
          MRP
        </th>
        <th scope="col" class="py-3 pr-5 text-right font-semibold">
          Page
        </th>
      </tr>
    </thead>
    <tbody>
      {skus.map(({ product, variant }) => (
        <tr class="odd:bg-white">
          <td class="py-3 pl-5">
            <span class="flex items-center gap-4">
              <span class="bg-stage grid size-14 shrink-0 place-items-center rounded-xl p-1.5">
                <Image
                  src={variant.image}
                  alt=""
                  widths={[112]}
                  sizes="56px"
                  format="jpg"
                  class:list={['w-auto', packPhotoFit(variant)]}
                />
              </span>
              <span class="font-bold text-navy-900">{product.data.name}</span>
            </span>
          </td>
          <td class="py-3 font-semibold text-navy-900">{variant.label}</td>
          <td class="py-3 text-ink-700">{variant.pack}</td>
          <td class="py-3 text-right text-base font-bold text-navy-900 tabular-nums">
            {formatMrp(variant.mrp)}
          </td>
          <td class="py-3 pr-5 text-right text-ink-600 tabular-nums">{pageOf[product.id]}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="mt-3 text-xs text-ink-500">
    MRP inclusive of all taxes.
    {alsoPackedIn.map(({ name, sizes }) => (
      <>
        {' '}
        {name} is also packed in {sizes.join(', ')}; ask the Dinar team for these packs.
      </>
    ))}
  </p>
</Sheet>
