---
/**
 * One pack presented as a product in its own right: a large studio shot beside its name,
 * what the pack promises as a checklist, and its facts ending in the MRP. The photo and the
 * button both lead to the pack's own detail page.
 */
import { Image } from 'astro:assets';
import CheckList from '@/components/products/CheckList.astro';
import SpecList from '@/components/products/SpecList.astro';
import Button from '@/components/ui/Button.astro';
import { packPhotoFit } from '@/lib/pack-photo';
import { skuName, skuPath, type ProductSku } from '@/lib/product-skus';

interface Props {
  sku: ProductSku;
}

const { sku } = Astro.props;
const { product, variant } = sku;
const { data } = product;
const href = skuPath(sku);
const headingId = `${sku.slug}-title`;
const isLandscape = variant.image.width > variant.image.height;

const specs = [
  { label: 'Net quantity', value: variant.label },
  { label: 'Pack', value: variant.pack },
  { label: 'Format', value: data.format },
  ...(data.suitableFor ? [{ label: 'Suitable for', value: data.suitableFor }] : []),
];
---

<article
  id={sku.slug}
  aria-labelledby={headingId}
  class="reveal grid scroll-mt-24 items-center gap-8 lg:grid-cols-12 lg:gap-14"
>
  {/* Out of the tab order so keyboards stop once per pack, at the button below. Screen
      readers still meet it, named by the photo's alt text. */}
  <a
    href={href}
    tabindex="-1"
    class:list={[
      'bg-stage group flex items-center justify-center overflow-hidden rounded-3xl p-8 sm:p-12 lg:col-span-6',
      isLandscape ? 'aspect-wide lg:aspect-4/3' : 'aspect-square',
    ]}
  >
    {/* The image box hugs the photo itself, so the edge fade lands on the photo's own
        backdrop and blends it into the stage instead of leaving a visible rectangle. */}
    <Image
      src={variant.image}
      alt={variant.imageAlt}
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 1280px) 584px, (min-width: 1024px) 46vw, 100vw"
      class:list={[
        'h-auto w-auto mask-x-from-85% mask-y-from-85% transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100',
        packPhotoFit(variant),
      ]}
    />
  </a>

  <div class="lg:col-span-6">
    <p class="font-semibold text-brand-700">
      {data.category}{' '}
      <span lang="hi" class="ml-1 font-medium text-ink-500">
        {data.categoryHi}
      </span>
    </p>
    <h3 id={headingId} class="mt-2 text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl">
      {data.name} <span class="whitespace-nowrap text-ink-500">{variant.label}</span>
    </h3>
    {data.tagline && (
      <p class="mt-3 text-lg font-semibold text-pretty text-brand-700">{data.tagline}</p>
    )}

    <div class="mt-6">
      <CheckList items={data.highlights} />
    </div>

    <div class="mt-8">
      <SpecList rows={specs} mrp={variant.mrp} />
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      {variant.onlineOrder && (
        <Button href={`${href}#order`} size="lg">
          Shop now <span class="sr-only">{skuName(sku)}</span>
        </Button>
      )}
      <Button
        href={href}
        variant={variant.onlineOrder ? 'outline' : 'navy'}
        size="lg"
        class={variant.onlineOrder ? 'text-navy-900' : ''}
      >
        View details <span class="sr-only">for {skuName(sku)}</span>
      </Button>
    </div>
  </div>
</article>
