---
/**
 * A product's formula features, grouped by what they do for the wash. Set as a typographic
 * list in three columns: the words carry it, so there are no icons to compete with them.
 */
import type { ProductFeature } from '@/content.config';
import { FEATURE_GROUP_IDS, FEATURE_GROUP_LABELS } from '@/data/feature-groups';

interface Props {
  productId: string;
  features: ProductFeature[];
}

const { productId, features } = Astro.props;
const headingId = `${productId}-features`;
const groups = FEATURE_GROUP_IDS.map((id) => ({
  id,
  ...FEATURE_GROUP_LABELS[id],
  items: features.filter(({ group }) => group === id),
})).filter(({ items }) => items.length > 0);
---

<section aria-labelledby={headingId} class="mt-20 grid gap-10 lg:mt-28 lg:grid-cols-12">
  <div class="lg:col-span-3">
    <h3 id={headingId} class="text-2xl font-semibold tracking-tight text-ink-950">
      What it does
    </h3>
    <p lang="hi" class="mt-1 text-ink-500">
      ख़ूबियाँ
    </p>
  </div>
  <div class="grid gap-10 sm:grid-cols-3 lg:col-span-9">
    {groups.map(({ label, labelHi, items }) => (
      <div>
        <h4 class="flex items-baseline justify-between gap-3 border-b border-ink-950 pb-3 text-sm font-medium text-ink-950">
          {label}{' '}
          <span lang="hi" class="font-normal text-ink-500">
            {labelHi}
          </span>
        </h4>
        <ul class="divide-y divide-ink-200">
          {items.map(({ title, description }) => (
            <li class="py-4">
              <p class="font-medium text-ink-950">{title}</p>
              <p class="mt-1 text-sm leading-6 text-ink-600">{description}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
