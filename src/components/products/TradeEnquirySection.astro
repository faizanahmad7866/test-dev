---
/** Closing band for retailers and distributors: where to apply, and the number to call. */
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { headerCta } from '@/config/navigation';
import { site } from '@/config/site';
import { formatPhone } from '@/lib/format-phone';
---

<section aria-labelledby="trade-title" class="bg-navy-900 py-14 text-white lg:py-20">
  <Container class="reveal grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7">
      <p class="font-semibold text-sun-400">
        Trade enquiries{' '}
        <span lang="hi" class="ml-2 font-medium text-white/70">
          व्यापार पूछताछ
        </span>
      </p>
      <h2
        id="trade-title"
        class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl"
      >
        Stock Dinar in your store
      </h2>
      <p class="mt-4 max-w-xl text-lg text-pretty text-white/80">
        Retailers, wholesalers and distributors can apply to stock the Dinar range.
      </p>
    </div>

    <div class="flex flex-col gap-6 sm:flex-row sm:items-center lg:col-span-5 lg:justify-end">
      <Button href={headerCta.href} variant="light" size="lg">
        Apply for dealership
      </Button>
      <p class="text-sm text-white/70">
        Or call us
        <a
          href={`tel:${site.supportPhone}`}
          class="block text-lg font-bold text-white tabular-nums transition-colors hover:text-sun-400"
        >
          {formatPhone(site.supportPhone)}
        </a>
      </p>
    </div>
  </Container>
</section>
