---
/** Benefits as a checklist: a red check in a soft circle beside each line, no rules between. */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  items: readonly string[];
  columns?: 1 | 2;
}

const { items, columns = 1 } = Astro.props;
---

<ul class:list={['grid gap-x-10 gap-y-4', columns === 2 && 'sm:grid-cols-2']}>
  {items.map((item) => (
    <li class="flex items-start gap-3">
      <span class="grid size-6 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700">
        <Icon name="check" class="size-4" />
      </span>
      <span class="font-medium text-navy-900">{item}</span>
    </li>
  ))}
</ul>
