---
/**
 * One pack as a product card: the pack on a soft studio backdrop, then name, size and MRP,
 * all one link to the pack's page. Beneath it, "Shop now" for packs sold online (opening
 * that page's WhatsApp order panel), otherwise "View details". Two separate links, never one
 * inside the other.
 */
import { Image } from 'astro:assets';
import { buttonClasses } from '@/lib/button-classes';
import { formatMrp } from '@/lib/format-mrp';
import { packPhotoFit } from '@/lib/pack-photo';
import { skuName, skuPath, type ProductSku } from '@/lib/product-skus';

interface Props {
  sku: ProductSku;
  sizes: string;
}

const { sku, sizes } = Astro.props;
const href = skuPath(sku);
---

<div class="reveal flex h-full flex-col">
  <a href={href} class="group block">
    <div class="bg-stage flex aspect-square items-center justify-center overflow-hidden rounded-2xl p-5 sm:p-8">
      <Image
        src={sku.variant.image}
        alt=""
        widths={[320, 480, 640, 800]}
        sizes={sizes}
        class:list={[
          'h-auto w-auto mask-x-from-85% mask-y-from-85% transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100',
          packPhotoFit(sku.variant),
        ]}
      />
    </div>
    <div class="mt-3 px-1 sm:mt-4">
      <p class="font-bold text-navy-900 transition-colors group-hover:text-brand-700 sm:text-lg">
        {sku.product.data.name}
      </p>
      <p class="mt-0.5 text-sm text-ink-600">
        {sku.variant.label} {sku.variant.pack.toLowerCase()}
      </p>
      <p class="mt-2 font-bold text-navy-900 tabular-nums">
        {formatMrp(sku.variant.mrp)}
        <span class="ml-1 text-xs font-medium text-ink-500">MRP</span>
      </p>
    </div>
  </a>
  <div class="mt-auto px-1 pt-3">
    {sku.variant.onlineOrder ? (
      <a href={`${href}#order`} class:list={[buttonClasses('primary', 'sm'), 'w-full']}>
        Shop now <span class="sr-only">{skuName(sku)}</span>
      </a>
    ) : (
      <a href={href} class:list={[buttonClasses('outline', 'sm'), 'w-full text-navy-900']}>
        View details <span class="sr-only">for {skuName(sku)}</span>
      </a>
    )}
  </div>
</div>
