---
/**
 * Full-screen menu below lg. A native popover: opens, closes on Esc and returns focus
 * without any JavaScript, so it works even before (or without) scripts.
 */
import ArrowIcon from '@/components/ui/ArrowIcon.astro';
import Button from '@/components/ui/Button.astro';
import SiteLogo from '@/components/layout/SiteLogo.astro';
import { headerCta, primaryNav } from '@/config/navigation';
import { isCurrentPath } from '@/lib/is-current-path';

interface Props {
  id: string;
}

const { id } = Astro.props;
const { pathname } = Astro.url;
---

<div
  id={id}
  popover
  class="fixed inset-0 m-0 size-full max-h-none max-w-none overflow-hidden border-0 bg-white p-0 text-ink-900 opacity-0 transition-all transition-discrete duration-300 ease-out open:opacity-100 starting:open:opacity-0 motion-reduce:transition-none lg:hidden"
>
  <div class="flex h-dvh flex-col">
    <div class="bg-rainbow h-1" aria-hidden="true"></div>

    <div class="mx-auto flex h-18 w-full max-w-7xl items-center justify-between px-4 sm:px-6">
      <SiteLogo />
      <button
        type="button"
        popovertarget={id}
        popovertargetaction="hide"
        aria-label="Close menu"
        class="grid size-11 place-items-center rounded-full bg-ink-50 text-navy-900 transition-colors hover:bg-ink-100 active:bg-ink-200"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M5 5l10 10M15 5L5 15"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Primary" class="mx-auto w-full max-w-7xl flex-1 overflow-y-auto px-4 sm:px-6">
      <ul class="space-y-2 pt-4">
        {primaryNav.map((item, index) => (
          <li
            class="animate-menu-item-in motion-reduce:animate-none"
            style={`animation-delay: ${80 + index * 60}ms`}
          >
            <a
              href={item.href}
              aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}
              class="group flex items-center justify-between gap-4 rounded-2xl bg-ink-50 px-5 py-4 text-2xl font-bold tracking-tight text-navy-900 transition-colors hover:text-brand-700 current:text-brand-700"
            >
              {item.label}
              <ArrowIcon class="size-5 text-ink-300 transition-transform group-hover:translate-x-1 group-hover:text-brand-700 group-current:text-brand-700 motion-reduce:transition-none" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mx-auto w-full max-w-7xl px-4 pt-4 pb-8 sm:px-6">
      <Button href={headerCta.href} size="lg" class="w-full">
        {headerCta.label}
      </Button>
    </div>
  </div>
</div>

<style>
  /* Freeze the page behind the open menu. Scoped to < lg so resizing to desktop never leaves it locked. */
  @media (width < 64rem) {
    :global(html:has([popover]:popover-open)) {
      overflow: hidden;
    }
  }
</style>
