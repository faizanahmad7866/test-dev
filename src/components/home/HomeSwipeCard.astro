---
/**
 * Home page, phones only: one pack in the swipeable row. The pack on its studio backdrop,
 * then name, size and MRP, the whole card one link to the pack's page, where ordering lives.
 */
import { Image } from 'astro:assets';
import { formatMrp } from '@/lib/format-mrp';
import { packPhotoFit } from '@/lib/pack-photo';
import { skuPath, type ProductSku } from '@/lib/product-skus';

interface Props {
  sku: ProductSku;
}

const { sku } = Astro.props;
const { product, variant } = sku;
---

<a href={skuPath(sku)} class="group block h-full">
  <div class="bg-stage flex aspect-square items-center justify-center overflow-hidden rounded-2xl p-5">
    <Image
      src={variant.image}
      alt=""
      widths={[320, 480, 640]}
      sizes="75vw"
      class:list={['h-auto w-auto mask-x-from-85% mask-y-from-85%', packPhotoFit(variant)]}
    />
  </div>
  <div class="mt-3 px-1">
    <p class="font-bold text-navy-900">{product.data.name}</p>
    <p class="mt-0.5 text-sm text-ink-600">
      {variant.label} {variant.pack.toLowerCase()}
    </p>
    <p class="mt-2 font-bold text-navy-900 tabular-nums">
      {formatMrp(variant.mrp)}
      <span class="ml-1 text-xs font-medium text-ink-500">MRP</span>
    </p>
  </div>
</a>
