---
/**
 * Home page only: one pack as a white card on the grey band. The pack on its studio
 * backdrop, then name, size and MRP, all leading to the pack's page.
 */
import { Image } from 'astro:assets';
import { buttonClasses } from '@/lib/button-classes';
import { formatMrp } from '@/lib/format-mrp';
import { packPhotoFit } from '@/lib/pack-photo';
import { skuName, skuPath, type ProductSku } from '@/lib/product-skus';

interface Props {
  sku: ProductSku;
}

const { sku } = Astro.props;
const { product, variant } = sku;
const href = skuPath(sku);
---

<article class="group flex h-full flex-col rounded-3xl bg-white p-4 transition duration-300 hover:-translate-y-1 lg:p-5 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
  <a
    href={href}
    tabindex="-1"
    class="bg-stage flex aspect-4/3 items-center justify-center overflow-hidden rounded-2xl p-6"
  >
    <Image
      src={variant.image}
      alt={variant.imageAlt}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 1280px) 360px, (min-width: 1024px) 29vw, (min-width: 640px) 45vw, 75vw"
      class:list={[
        'h-auto w-auto mask-x-from-85% mask-y-from-85% transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100',
        packPhotoFit(variant),
      ]}
    />
  </a>
  <div class="mt-4 flex flex-1 flex-col px-1">
    <h3 class="text-lg font-bold text-navy-900">
      <a href={href} class="transition-colors hover:text-brand-700">
        {product.data.name}
      </a>
    </h3>
    <p class="mt-0.5 text-sm text-ink-600">
      {variant.label} {variant.pack.toLowerCase()}
    </p>
    <p class="mt-3 flex items-baseline gap-1.5">
      <span class="text-xl font-bold text-navy-900 tabular-nums">{formatMrp(variant.mrp)}</span>
      <span class="text-xs font-medium text-ink-500">MRP</span>
    </p>
    <div class="mt-auto pt-4">
      <a href={href} class:list={[buttonClasses('outline', 'sm'), 'w-full text-navy-900']}>
        View details <span class="sr-only">for {skuName(sku)}</span>
      </a>
    </div>
  </div>
</article>
