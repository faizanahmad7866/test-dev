---
/**
 * Call-to-action link: an <a> styled as a pill (see lib/button-classes for the variants).
 * `class` is for layout only (width, margin). Toggle visibility on a wrapper — a `hidden`
 * passed here loses to the built-in `inline-flex`.
 */
import { buttonClasses, type ButtonSize, type ButtonVariant } from '@/lib/button-classes';

interface Props {
  href: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  /** Open in a new tab, for hand-offs such as WhatsApp that should leave this page open. */
  newTab?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', newTab = false, class: className } = Astro.props;
---

<a
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener' : undefined}
  class:list={[buttonClasses(variant, size), className]}
>
  <slot />
</a>
