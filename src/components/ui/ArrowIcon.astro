---
/** Right arrow used on CTAs and menu rows. Decorative — the link text carries the meaning. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['size-4 shrink-0', className]}
>
  <path d="M4 10h12M11 5l5 5-5 5"></path>
</svg>
