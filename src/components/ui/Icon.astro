---
/**
 * Named icon from our Lucide subset. Rendered to SVG at build time — no client JS.
 * Decorative: Lucide adds aria-hidden, so the surrounding text must carry the meaning.
 */
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Download from '@lucide/astro/icons/download';
import type { IconName } from '@/lib/icon-names';

interface Props {
  name: IconName;
  class?: string;
}

const ICONS = {
  check: Check,
  'chevron-down': ChevronDown,
  download: Download,
} satisfies Record<IconName, typeof ChevronDown>;

const { name, class: className = 'size-5' } = Astro.props;
const Component = ICONS[name];
---

<Component class:list={['shrink-0', className]} stroke-width={1.75} />
