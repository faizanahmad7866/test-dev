---
/**
 * Per-page <head> metadata: title, description, canonical, Open Graph and JSON-LD.
 * Relies on `site` in astro.config so canonical and OG URLs are absolute.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import defaultOgImage from '@/assets/brand/dinar-range-lineup.jpg';
import { site } from '@/config/site';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  schema?: Record<string, unknown>;
}

const OG_WIDTH = 1200;
const OG_HEIGHT = 630;

const { title, description, image = defaultOgImage, schema } = Astro.props;

const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = await getImage({
  src: image,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  fit: 'cover',
  format: 'jpg',
});
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
// Escape `<` so no string inside the data can close the script tag early.
const jsonLd = schema && JSON.stringify(schema).replaceAll('<', '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
