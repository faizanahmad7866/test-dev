---
/**
 * The WhatsApp order panel for one product: pick the pack size and quantity on the left (with
 * a live total at MRP), give delivery details on the right, then "Place order on WhatsApp"
 * opens WhatsApp in a new tab with the order written out for the Dinar team. A native
 * <dialog>: Esc closes it and focus stays inside. src/scripts/order-dialog.ts drives it;
 * anything with data-js="order-open" opens it, and so does arriving at the page with #order.
 */
import { Image } from 'astro:assets';
import FieldError from '@/components/forms/FieldError.astro';
import TextField from '@/components/forms/TextField.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { buttonClasses } from '@/lib/button-classes';
import { formatMrp } from '@/lib/format-mrp';
import { formatPhone } from '@/lib/format-phone';
import { packPhotoFit } from '@/lib/pack-photo';
import { skuName, type ProductSku } from '@/lib/product-skus';
import { ORDER_MAX_QUANTITY, ORDER_NOTE_MAX_LENGTH } from '@/lib/schemas/order';
import { buildWhatsAppUrl } from '@/lib/whatsapp';

interface Props {
  sku: ProductSku;
  /** The packs of this product sold online, the current one included: the size choices. */
  siblings: ProductSku[];
}

const { sku, siblings } = Astro.props;
const { data } = sku.product;
const whatsappNumber = formatPhone(site.whatsappNumber);
const startTotal = formatMrp(sku.variant.mrp);
const stepTitleClass = 'text-xs font-bold tracking-wide text-ink-500 uppercase';
const stepperButtonClass =
  'grid size-11 place-items-center rounded-full text-xl font-bold text-navy-900 transition-colors hover:bg-ink-50 disabled:cursor-not-allowed disabled:opacity-30 motion-reduce:transition-none';
---

<dialog
  data-js="order-dialog"
  data-whatsapp-number={site.whatsappNumber}
  data-max-quantity={ORDER_MAX_QUANTITY}
  aria-labelledby="order-title"
  class="order-dialog"
>
  <header class="flex shrink-0 items-center justify-between gap-4 border-b border-ink-100 px-5 py-4 sm:px-8 sm:py-5">
    <div class="min-w-0">
      <p class="text-xs font-bold tracking-wide text-brand-700 uppercase">
        Order on WhatsApp{' '}
        <span lang="hi" class="ml-1 font-semibold tracking-normal normal-case">
          व्हाट्सऐप पर ऑर्डर
        </span>
      </p>
      <h2
        id="order-title"
        class="mt-0.5 truncate text-xl font-bold tracking-tight text-navy-900 sm:text-2xl"
      >
        {data.name}
      </h2>
    </div>
    <button
      type="button"
      data-order-close
      aria-label="Close"
      class="grid size-11 shrink-0 place-items-center rounded-full bg-ink-50 text-navy-900 transition-colors hover:bg-ink-100 motion-reduce:transition-none"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        class="size-5"
      >
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
  </header>

  <form data-js="order-form" class="flex min-h-0 flex-1 flex-col">
    <div class="min-h-0 flex-1 overflow-y-auto">
      <div class="grid lg:grid-cols-12">
        <section aria-labelledby="order-pack-title" class="bg-ink-50 p-5 sm:p-8 lg:col-span-5">
          <h3 id="order-pack-title" class={stepTitleClass}>
            1 · Your order
          </h3>

          <fieldset aria-describedby="field-variant-error" class="mt-4">
            <legend class="text-sm font-semibold text-navy-900">Pack size</legend>
            <div class="mt-2 grid gap-2">
              {siblings.map((sibling) => (
                <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-ink-200 bg-white p-3 transition-colors select-none hover:border-ink-400 has-checked:border-navy-900 has-checked:ring-1 has-checked:ring-navy-900 motion-reduce:transition-none">
                  <input
                    type="radio"
                    name="variant"
                    value={sibling.variant.id}
                    checked={sibling.slug === sku.slug}
                    data-name={skuName(sibling)}
                    data-pack={sibling.variant.pack}
                    data-mrp={sibling.variant.mrp}
                    class="size-4 shrink-0 cursor-pointer accent-navy-900"
                  />
                  <span class="bg-stage grid size-14 shrink-0 place-items-center overflow-hidden rounded-xl p-1.5">
                    <Image
                      src={sibling.variant.image}
                      alt=""
                      widths={[112]}
                      sizes="56px"
                      class:list={['h-auto w-auto', packPhotoFit(sibling.variant)]}
                    />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-bold text-navy-900">{sibling.variant.label}</span>
                    <span class="block text-sm text-ink-600">{sibling.variant.pack}</span>
                  </span>
                  <span class="font-bold text-navy-900 tabular-nums">
                    {formatMrp(sibling.variant.mrp)}
                  </span>
                </label>
              ))}
            </div>
            <FieldError id="field-variant-error" name="variant" />
          </fieldset>

          <div class="mt-6">
            <label for="field-quantity" class="text-sm font-semibold text-navy-900">
              Quantity
            </label>
            <div class="mt-2 flex items-center gap-4">
              <div class="inline-flex items-center rounded-full border border-ink-300 bg-white p-0.5">
                <button
                  type="button"
                  data-order-step="-1"
                  aria-label="One pack fewer"
                  class={stepperButtonClass}
                >
                  −
                </button>
                <input
                  id="field-quantity"
                  name="quantity"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value="1"
                  maxlength={2}
                  aria-describedby="field-quantity-error"
                  class="w-12 bg-transparent text-center text-lg font-bold text-navy-900 tabular-nums focus:outline-none"
                />
                <button
                  type="button"
                  data-order-step="1"
                  aria-label="One pack more"
                  class={stepperButtonClass}
                >
                  +
                </button>
              </div>
              <span class="text-sm text-ink-600">packs</span>
            </div>
            <FieldError id="field-quantity-error" name="quantity" />
          </div>

          <dl class="mt-6 space-y-2 rounded-2xl bg-white p-4 text-sm">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Price per pack (MRP)</dt>
              <dd data-order-each class="font-semibold text-navy-900 tabular-nums">
                {startTotal}
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Quantity</dt>
              <dd data-order-quantity class="font-semibold text-navy-900 tabular-nums">
                1
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 pt-2">
              <dt class="font-bold text-navy-900">Total at MRP</dt>
              <dd
                data-order-total
                class="text-2xl font-bold tracking-tight text-navy-900 tabular-nums"
              >
                {startTotal}
              </dd>
            </div>
          </dl>
          <p class="mt-3 text-xs leading-5 text-ink-600">
            MRP inclusive of all taxes. The Dinar team confirms availability, delivery and the final
            amount with you on WhatsApp.
          </p>
        </section>

        <section aria-labelledby="order-delivery-title" class="p-5 sm:p-8 lg:col-span-7">
          <h3 id="order-delivery-title" class={stepTitleClass}>
            2 · Delivery details
          </h3>
          <div class="mt-4 grid gap-x-5 gap-y-5 sm:grid-cols-2">
            <TextField
              name="fullName"
              label="Full name"
              isRequired
              isWide
              autocomplete="name"
              maxlength={80}
            />
            <TextField
              name="phone"
              label="Mobile number"
              type="tel"
              prefix="+91"
              isRequired
              isWide
              autocomplete="tel-national"
              inputmode="tel"
              maxlength={16}
              hint="The Dinar team confirms your order on this number."
            />
            <TextField
              name="address"
              label="Address"
              isRequired
              isWide
              autocomplete="street-address"
              maxlength={200}
              placeholder="House no., street, area"
            />
            <TextField
              name="city"
              label="City or town"
              isRequired
              autocomplete="address-level2"
              maxlength={80}
            />
            <TextField
              name="pincode"
              label="PIN code"
              isRequired
              autocomplete="postal-code"
              inputmode="numeric"
              maxlength={7}
            />
            <TextField
              name="note"
              label="Note"
              isWide
              maxlength={ORDER_NOTE_MAX_LENGTH}
              placeholder="Landmark, or a good time to call"
            />
          </div>
        </section>
      </div>
    </div>

    <footer class="shrink-0 border-t border-ink-100 bg-white px-5 py-4 sm:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="flex items-baseline justify-between gap-3 sm:block">
          <span class="text-sm text-ink-600">Total at MRP</span>
          <span data-order-total class="text-xl font-bold text-navy-900 tabular-nums sm:ml-2">
            {startTotal}
          </span>
        </p>
        <button type="submit" class:list={[buttonClasses('primary', 'lg'), 'w-full sm:w-auto']}>
          Place order on WhatsApp
        </button>
      </div>
      <p class="mt-2 text-xs text-ink-500">
        WhatsApp opens in a new tab with your order ready to send to the Dinar team on{' '}
        <span class="whitespace-nowrap">{whatsappNumber}</span>.
      </p>
    </footer>
  </form>

  <div
    data-order-success
    hidden
    class="flex flex-1 flex-col items-center justify-center px-6 py-16 text-center"
  >
    <span class="grid size-14 place-items-center rounded-full bg-brand-50 text-brand-700">
      <Icon name="check" class="size-7" />
    </span>
    <h3
      data-order-success-heading
      tabindex="-1"
      class="mt-6 text-3xl font-bold tracking-tight text-navy-900 focus:outline-none"
    >
      Now press Send in WhatsApp
    </h3>
    <p class="mt-3 max-w-md text-ink-600">
      Your order is written out in WhatsApp, in a new tab, addressed to the Dinar team on{' '}
      <span class="font-bold whitespace-nowrap text-navy-900">{whatsappNumber}</span>
      {'. They will confirm it with you on WhatsApp.'}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button type="button" data-order-done class={buttonClasses('navy', 'lg')}>
        Done
      </button>
      <a
        data-order-whatsapp
        href={buildWhatsAppUrl(site.whatsappNumber, '')}
        target="_blank"
        rel="noopener"
        class:list={[buttonClasses('outline', 'lg'), 'text-navy-900']}
      >
        Open WhatsApp again
      </a>
    </div>
  </div>
</dialog>

<script>
  import { initOrderDialog } from '@/scripts/order-dialog';

  initOrderDialog();
</script>
