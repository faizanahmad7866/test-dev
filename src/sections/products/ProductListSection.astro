---
/** The product list: every pack of every product, each presented separately and numbered. */
import ProductListItem from '@/components/products/ProductListItem.astro';
import Container from '@/components/ui/Container.astro';
import type { Product } from '@/content.config';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const items = products.flatMap((product) =>
  product.data.variants.map((variant) => ({ product, variant })),
);
---

<section aria-labelledby="product-list-title" class="pt-20 pb-24 lg:pt-28 lg:pb-36">
  <Container>
    <div class="flex items-baseline justify-between gap-4 border-b border-ink-950 pb-4">
      <h2 id="product-list-title" class="text-xl font-semibold tracking-tight text-ink-950">
        Product list
      </h2>
      <p lang="hi" class="text-ink-500">
        उत्पाद सूची
      </p>
    </div>

    <div>
      {items.map(({ product, variant }, index) => (
        <ProductListItem
          product={product}
          variant={variant}
          position={index + 1}
          total={items.length}
        />
      ))}
    </div>
  </Container>
</section>
