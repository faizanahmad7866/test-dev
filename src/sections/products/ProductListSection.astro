---
/** The product list: every pack of every product, each presented separately and linked to its own page. */
import ProductListItem from '@/components/products/ProductListItem.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import type { ProductSku } from '@/lib/product-skus';

interface Props {
  skus: ProductSku[];
}

const { skus } = Astro.props;
---

<section aria-labelledby="product-list-title" class="py-14 lg:py-20">
  <Container>
    <SectionHeader
      id="product-list-title"
      title="All packs"
      subtitle="Each pack has its own page with the full details."
    />
    <div class="mt-10 flex flex-col gap-14 lg:mt-12 lg:gap-20">
      {skus.map((sku) => (
        <ProductListItem sku={sku} />
      ))}
    </div>
  </Container>
</section>
