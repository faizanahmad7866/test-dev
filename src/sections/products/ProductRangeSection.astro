---
/** Product details: one chapter per product family, after the pack-by-pack product list. */
import ProductChapter from '@/components/products/ProductChapter.astro';
import Container from '@/components/ui/Container.astro';
import type { Product } from '@/content.config';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<Container class="pb-24 lg:pb-36">
  <p class="flex items-baseline justify-between gap-4 pb-10 text-sm text-ink-500 lg:pb-14">
    <span>Product details</span>
    <span lang="hi">उत्पाद विवरण</span>
  </p>
  <div class="space-y-24 lg:space-y-36">
    {products.map((product) => (
      <ProductChapter product={product} />
    ))}
  </div>
</Container>
