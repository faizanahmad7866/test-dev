---
/**
 * Products page opening: one band in the colours of the range studio shot, holding the
 * title, the introduction and the photo itself. The photo has no frame: its edges fade into
 * the band and its floor into the page, so it reads as part of the page rather than a
 * picture placed on it. Full-bleed on phones, where every pixel of width counts.
 * The photo is the LCP element, so the page hands in a pre-built image it also preloads.
 */
import type { GetImageResult } from 'astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Container from '@/components/ui/Container.astro';

interface Props {
  banner: GetImageResult;
  sizes: string;
}

const { banner, sizes } = Astro.props;
---

<section aria-labelledby="products-title" class="bg-studio pt-6 lg:pt-10">
  <Container>
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Products', href: '/products/' },
      ]}
    />

    <div class="mt-8 grid gap-4 lg:mt-10 lg:grid-cols-12 lg:items-end lg:gap-10">
      <h1
        id="products-title"
        class="text-4xl font-bold tracking-tight text-navy-900 sm:text-5xl lg:col-span-7 lg:text-6xl"
      >
        Our products
      </h1>
      <p class="text-lg text-pretty text-ink-700 lg:col-span-5">
        Detergent powder and detergent cake for everyday laundry. Every pack size, with its MRP.
      </p>
    </div>
  </Container>

  <figure class="mx-auto mt-4 max-w-6xl sm:mt-6">
    {/* getImage + <img> rather than <Image>: the same srcset must also feed the head preload. */}
    <img
      src={banner.src}
      srcset={banner.srcSet.attribute}
      sizes={sizes}
      width={banner.attributes['width']}
      height={banner.attributes['height']}
      alt="The Dinar range on a pale blue studio backdrop: two Detergent Powder packs, Super Wash and Detergent Cake"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-auto w-full mask-x-from-90% mask-t-from-90% mask-b-from-80%"
    />
    <Container>
      <figcaption class="text-center text-sm text-ink-600">
        From left: two Detergent Powder packs, Super Wash and, in front, Detergent Cake.
      </figcaption>
    </Container>
  </figure>
</section>
