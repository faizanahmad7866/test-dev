---
/** Closing band for retailers and distributors: where to apply, and the number to call. */
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { headerCta } from '@/config/navigation';
import { site } from '@/config/site';
import { formatPhone } from '@/lib/format-phone';
---

<section aria-labelledby="trade-title" class="bg-ink-950 py-20 text-white lg:py-28">
  <Container class="grid gap-12 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="flex items-baseline gap-3 text-sm">
        <span class="font-medium">Trade enquiries</span>
        <span lang="hi" class="text-white/60">
          व्यापार पूछताछ
        </span>
      </p>
      <h2
        id="trade-title"
        class="mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
      >
        Stock Dinar in your store.
      </h2>
      <p class="mt-5 max-w-lg text-lg leading-8 text-white/70">
        Retailers, wholesalers and distributors can apply to stock the Dinar range.
      </p>
    </div>

    <div class="flex flex-col gap-8 lg:col-span-5 lg:items-end">
      <Button href={headerCta.href} variant="light" size="lg">
        Apply for dealership
      </Button>
      <p class="text-sm text-white/60 lg:text-right">
        Customer support and feedback
        <a
          href={`tel:${site.supportPhone}`}
          class="mt-1 block text-lg font-medium text-white tabular-nums transition-colors hover:text-white/80"
        >
          {formatPhone(site.supportPhone)}
        </a>
      </p>
    </div>
  </Container>
</section>
