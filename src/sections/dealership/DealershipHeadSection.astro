---
/** Dealership page opening: title, the offer in the company's voice, and the direct line. */
import CatalogueDownloadLink from '@/components/catalogue/CatalogueDownloadLink.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { site } from '@/config/site';
import { formatPhone } from '@/lib/format-phone';
---

<section aria-labelledby="dealership-title" class="pt-6 pb-12 lg:pt-10 lg:pb-16">
  <Container>
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Dealership', href: '/dealership/' },
      ]}
    />

    <div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-7">
        <p class="font-semibold text-brand-700">
          Dealership{' '}
          <span lang="hi" class="ml-1 font-medium text-ink-500">
            डीलरशिप
          </span>
        </p>
        <h1
          id="dealership-title"
          class="mt-2 text-4xl font-bold tracking-tight text-balance text-navy-900 sm:text-5xl lg:text-6xl"
        >
          Become a Dinar dealer
        </h1>
      </div>
      <div class="lg:col-span-5">
        <p class="text-lg text-pretty text-ink-600">
          Dinar works with retailers, wholesalers and distributors. Tell us about your business and
          the area you cover, and the Dinar team will get in touch.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href="#application" size="lg">
            Apply now
          </Button>
          <p class="text-sm text-ink-600">
            Or call{' '}
            <a
              href={`tel:${site.supportPhone}`}
              class="font-bold text-navy-900 tabular-nums transition-colors hover:text-brand-700"
            >
              {formatPhone(site.supportPhone)}
            </a>
          </p>
        </div>
        <CatalogueDownloadLink class="mt-3 text-sm text-navy-900 hover:text-brand-700" />
      </div>
    </div>
  </Container>
</section>
