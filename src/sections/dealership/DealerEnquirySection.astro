---
/**
 * The enquiry form beside a sticky aside: the packs a dealer would stock, and the phone line.
 * The form comes first in the DOM so phones and screen readers reach it before the extras.
 */
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import type { Product } from '@/content.config';
import { formatMrp } from '@/lib/format-mrp';
import { formatPhone } from '@/lib/format-phone';
import DealerLeadForm from '@/sections/dealership/DealerLeadForm.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const packs = products.flatMap(({ data }) =>
  data.variants.map((variant) => ({ name: data.name, variant })),
);
---

<section id="enquiry" class="scroll-mt-24 bg-mist-50 py-14 lg:py-20">
  <Container class="grid gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-8">
      <DealerLeadForm products={products} />
    </div>

    <aside
      aria-label="Range and contact"
      class="space-y-6 lg:sticky lg:top-28 lg:col-span-4 lg:self-start lg:order-first"
    >
      <div class="rounded-3xl bg-white p-6 ring-1 ring-ink-200">
        <p class="text-xs font-bold tracking-widest text-brand-700 uppercase">
          The range you'll stock
        </p>
        <ul class="mt-4 divide-y divide-ink-200">
          {packs.map(({ name, variant }) => (
            <li class="flex items-center gap-4 py-3">
              <Image
                src={variant.image}
                alt=""
                widths={[48, 96]}
                sizes="48px"
                class="size-12 shrink-0 rounded-xl bg-mist-100 object-contain p-1"
              />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold text-navy-900">{name}</span>
                <span class="block text-xs text-ink-500">{variant.label} pack</span>
              </span>
              <span class="text-right">
                <span class="block text-xs text-ink-500">MRP</span>
                <span class="block text-sm font-extrabold text-navy-900 tabular-nums">
                  {formatMrp(variant.mrp)}
                </span>
              </span>
            </li>
          ))}
        </ul>
        <a
          href="/products/"
          class="mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-navy-900 transition-colors hover:text-brand-700"
        >
          See full product details
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="relative overflow-hidden rounded-3xl bg-navy-900 p-6 text-white">
        <div class="bg-rainbow absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>
        <p class="text-xs font-bold tracking-widest text-white/80 uppercase">Prefer to talk?</p>
        <p class="mt-2 text-sm text-white/75">Call our customer support and feedback line.</p>
        <a
          href={`tel:${site.supportPhone}`}
          class="mt-4 flex items-center gap-3 rounded-2xl bg-white/10 p-3 ring-1 ring-white/15 transition-colors hover:bg-white/15 motion-reduce:transition-none"
        >
          <span class="grid size-11 place-items-center rounded-xl bg-white text-navy-900">
            <Icon name="phone" class="size-5" />
          </span>
          <span class="text-lg font-extrabold tracking-tight tabular-nums">
            {formatPhone(site.supportPhone)}
          </span>
        </a>
      </div>
    </aside>
  </Container>
</section>
