---
/**
 * Dealer application form and its confirmation. Field names match dealerLeadSchema exactly;
 * src/scripts/dealer-lead-form.ts validates, submits and swaps the two.
 */
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import ChoiceGroup from '@/components/forms/ChoiceGroup.astro';
import FieldError from '@/components/forms/FieldError.astro';
import FieldLabel from '@/components/forms/FieldLabel.astro';
import FormStep from '@/components/forms/FormStep.astro';
import SelectField from '@/components/forms/SelectField.astro';
import TextField from '@/components/forms/TextField.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import type { Product } from '@/content.config';
import { BUSINESS_TYPES, MONTHLY_VOLUMES, YEARS_IN_BUSINESS } from '@/data/dealer-form-options';
import { INDIAN_STATES } from '@/data/indian-states';
import { buildWhatsAppUrl } from '@/lib/whatsapp';
import { formatPhone } from '@/lib/format-phone';
import { MESSAGE_MAX_LENGTH } from '@/lib/schemas/dealer-lead';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const supportPhone = formatPhone(site.supportPhone);
const productChoices = products.map(({ id, data }) => ({
  value: id,
  label: data.name,
  description: data.variants.map(({ label }) => label).join(' · '),
}));
const stateOptions = INDIAN_STATES.map((state) => ({ value: state, label: state }));
const whatsappNumber = formatPhone(site.whatsappNumber);
// The plain chat until the script swaps in the link carrying the application.
const whatsappChatUrl = buildWhatsAppUrl(site.whatsappNumber, '');
const productNames = JSON.stringify(
  Object.fromEntries(products.map(({ id, data }) => [id, data.name])),
);
---

<div data-js="dealer-lead-card" class="scroll-mt-28">
  {/* POST and a disabled submit until the script is ready: if the script ever fails to load,
      the browser cannot fall back to a GET that puts the visitor's details in the URL. */}
  <form
    method="post"
    data-js="dealer-lead-form"
    data-turnstile-site-key={PUBLIC_TURNSTILE_SITE_KEY}
    data-whatsapp-number={site.whatsappNumber}
    data-product-names={productNames}
    aria-labelledby="dealer-form-title"
    class="space-y-12"
  >
    <div>
      <h2
        id="dealer-form-title"
        class="text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl"
      >
        Dealer application{' '}
        <span lang="hi" class="ml-1 text-lg font-medium tracking-normal text-ink-500">
          डीलर आवेदन
        </span>
      </h2>
      <p class="mt-3 text-sm text-ink-600">
        Fields marked <span class="text-brand-700">*</span> are required.
      </p>

      <noscript>
        <p class="mt-6 rounded-xl bg-ink-50 px-4 py-3 text-sm font-medium text-navy-900">
          This form needs JavaScript to keep spam out. You can also call us on {supportPhone}.
        </p>
      </noscript>

      <div
        data-js="form-alert"
        role="alert"
        hidden
        class="mt-6 rounded-xl bg-brand-50 px-4 py-3 text-sm font-medium text-brand-900"
      >
        <span data-alert-text></span>
      </div>
    </div>

    <FormStep step={1} title="Contact details" titleHi="संपर्क">
      <TextField name="fullName" label="Full name" isRequired autocomplete="name" maxlength={80} />
      <TextField
        name="phone"
        label="Mobile number"
        type="tel"
        prefix="+91"
        isRequired
        autocomplete="tel-national"
        inputmode="tel"
        maxlength={16}
        hint="We will call you on this number."
      />
      <TextField
        name="email"
        label="Email"
        type="email"
        isWide
        autocomplete="email"
        maxlength={120}
      />
    </FormStep>

    <FormStep step={2} title="Business" titleHi="व्यापार">
      <TextField
        name="businessName"
        label="Shop or firm name"
        isRequired
        isWide
        autocomplete="organization"
        maxlength={120}
      />
      <ChoiceGroup
        name="businessType"
        legend="Type of business"
        type="radio"
        options={BUSINESS_TYPES}
        isRequired
        columns={3}
      />
      <TextField
        name="gstin"
        label="GSTIN"
        isUppercase
        autocomplete="off"
        maxlength={17}
        placeholder="22AAAAA0000A1Z5"
        hint="15 characters, as on your GST certificate."
      />
      <SelectField
        name="yearsInBusiness"
        label="Years in business"
        placeholder="Select"
        options={YEARS_IN_BUSINESS}
      />
    </FormStep>

    <FormStep step={3} title="Location" titleHi="स्थान">
      <SelectField
        name="state"
        label="State"
        placeholder="Select your state"
        options={stateOptions}
        isRequired
        autocomplete="address-level1"
      />
      <TextField
        name="city"
        label="City or district"
        isRequired
        autocomplete="address-level2"
        maxlength={80}
      />
      <TextField
        name="pincode"
        label="PIN code"
        isRequired
        autocomplete="postal-code"
        inputmode="numeric"
        maxlength={7}
      />
    </FormStep>

    <FormStep step={4} title="Requirement" titleHi="आवश्यकता">
      <ChoiceGroup
        name="products"
        legend="Products you want to stock"
        type="checkbox"
        options={productChoices}
        isRequired
      />
      <SelectField
        name="monthlyVolume"
        label="Expected monthly order"
        placeholder="Select a range"
        options={MONTHLY_VOLUMES}
      />
      <div class="sm:col-span-2">
        <FieldLabel for="field-message" label="Message" isRequired={false} />
        <textarea
          id="field-message"
          name="message"
          rows="4"
          maxlength={MESSAGE_MAX_LENGTH}
          aria-describedby="field-message-count field-message-error"
          placeholder="Areas you cover, brands you stock today, a good time to call"
          class="mt-2 block w-full resize-y rounded-xl border border-ink-300 bg-white px-3.5 py-3 text-base text-navy-900 transition-colors placeholder:text-ink-400 hover:border-ink-500 focus:border-navy-900 focus:ring-1 focus:ring-navy-900 focus:outline-none aria-invalid:border-brand-700 aria-invalid:ring-1 aria-invalid:ring-brand-700 motion-reduce:transition-none"
        ></textarea>
        <p
          id="field-message-count"
          data-js="message-counter"
          class="mt-2 text-right text-xs text-ink-500 tabular-nums"
        >
          0 / {MESSAGE_MAX_LENGTH.toLocaleString('en-IN')}
        </p>
        <FieldError id="field-message-error" name="message" />
      </div>
    </FormStep>

    <div class="rounded-2xl bg-ink-50 p-5 sm:p-6">
      <label class="flex cursor-pointer items-start gap-3">
        <input
          type="checkbox"
          name="consent"
          required
          aria-describedby="field-consent-error"
          class="mt-1 size-4 shrink-0 cursor-pointer accent-navy-900"
        />
        <span class="text-sm leading-6 font-medium text-navy-900">
          I agree that Dinar may contact me by phone, WhatsApp or email about this application.
          <span class="text-brand-700" aria-hidden="true">
            *
          </span>
        </span>
      </label>
      <FieldError id="field-consent-error" name="consent" />

      <div aria-hidden="true" class="sr-only">
        <label for="field-website">Leave this field empty</label>
        <input id="field-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div data-js="turnstile" class="mt-6"></div>

      <div class="mt-8 flex flex-col-reverse gap-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-sm text-xs leading-5 text-ink-600">
          WhatsApp opens with your application ready to send to the Dinar team on{' '}
          <span class="font-semibold whitespace-nowrap text-navy-900 tabular-nums">
            {whatsappNumber}
          </span>
          . Protected from spam by Cloudflare Turnstile.
        </p>
        <button
          type="submit"
          disabled
          class="inline-flex h-13 w-full items-center justify-center rounded-full bg-brand-700 px-7 text-base font-bold text-white transition active:translate-y-px hover:bg-brand-800 active:bg-brand-900 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto motion-reduce:transition-none"
        >
          Submit on WhatsApp
        </button>
      </div>
    </div>
  </form>

  <div data-js="dealer-lead-success" hidden>
    <span class="grid size-12 place-items-center rounded-full bg-brand-50 text-brand-700">
      <Icon name="check" class="size-6" />
    </span>
    <p class="mt-6 font-semibold text-brand-700">
      Opened in WhatsApp{' '}
      <span lang="hi" class="ml-1 font-medium text-ink-500">
        व्हाट्सऐप में खुला
      </span>
    </p>
    <h2
      data-success-heading
      tabindex="-1"
      class="mt-2 text-4xl font-bold tracking-tight text-navy-900 focus:outline-none sm:text-5xl"
    >
      Now press Send in WhatsApp
    </h2>
    <p class="mt-4 max-w-lg text-lg text-ink-600">
      Your application is written out in WhatsApp, in a new tab, addressed to the Dinar team on{' '}
      <span class="font-bold whitespace-nowrap text-navy-900 tabular-nums">{whatsappNumber}</span>
      {'. Press Send there to deliver it. We will call you on '}
      <span
        data-success-phone
        class="font-bold whitespace-nowrap text-navy-900 tabular-nums"
      ></span>
      {'.'}
    </p>
    <div data-success-reference-block hidden class="mt-8 max-w-md rounded-2xl bg-ink-50 p-5">
      <p class="text-sm text-ink-600">Your reference</p>
      <p data-success-reference class="mt-1 font-mono text-lg font-semibold text-navy-900"></p>
      <p class="mt-2 text-xs text-ink-600">Quote it if you call us on {supportPhone}.</p>
    </div>
    <p class="mt-8 text-sm text-ink-600">
      WhatsApp did not open?{' '}
      <a
        href={whatsappChatUrl}
        target="_blank"
        rel="noopener"
        data-success-whatsapp
        class="font-bold text-navy-900 underline underline-offset-4 transition-colors hover:text-brand-700"
      >
        Open it again
      </a>
    </p>
  </div>
</div>

<script>
  import { initDealerLeadForm } from '@/scripts/dealer-lead-form';

  initDealerLeadForm();
</script>
