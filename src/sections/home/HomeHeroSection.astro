---
/**
 * Home hero: the product film as a clean, full-width band under the header, then an
 * editorial head on white, matching the products and dealership pages. Phones get their
 * own 4:5 cut of the film, cropped from the 1080p master so the packs stay sharp.
 * The h1 comes first in the DOM, so reading order never depends on the visual order.
 * The poster is a real responsive image (the LCP element, preloaded by the page); the silent
 * loop fades in over it once playing.
 */
import type { GetImageResult } from 'astro';
import heroMp4Large from '@/assets/video/dinar-hero-1080.mp4';
import heroWebmLarge from '@/assets/video/dinar-hero-1080.webm';
import heroMp4Small from '@/assets/video/dinar-hero-720.mp4';
import heroWebmSmall from '@/assets/video/dinar-hero-720.webm';
import heroMp4Portrait from '@/assets/video/dinar-hero-portrait.mp4';
import heroWebmPortrait from '@/assets/video/dinar-hero-portrait.webm';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { headerCta } from '@/config/navigation';
import { site } from '@/config/site';
import { PHONE_MEDIA } from '@/sections/home/hero-media';

interface Props {
  poster: GetImageResult;
  posterPortrait: GetImageResult;
  sizes: string;
}

const { poster, posterPortrait, sizes } = Astro.props;
// Exact codecs let a browser without AV1 skip straight to the MP4.
const SMALL_SCREEN = '(max-width: 767px)';
---

<section aria-labelledby="home-title" class="flex flex-col bg-white">
  <Container class="order-last py-12 lg:py-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="reveal lg:col-span-7">
        <h1
          id="home-title"
          class="text-4xl font-bold tracking-tight text-balance text-navy-900 sm:text-5xl lg:text-6xl"
        >
          Freshness and brilliance after every wash.
        </h1>
        <p lang="hi" class="mt-4 text-xl font-semibold text-brand-700 sm:text-2xl">
          हर Wash के बाद Freshness और Brilliance!
        </p>
      </div>
      <div class="reveal lg:col-span-5">
        <p class="max-w-md text-lg leading-8 text-pretty text-ink-700">
          Dinar Super Wash, Dinar Detergent Powder and Dinar Detergent Cake, for everyday laundry.{' '}
          {site.tagline}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/products/" variant="navy" size="lg">
            Explore products
          </Button>
          <Button href={headerCta.href} variant="outline" size="lg" class="text-navy-900">
            {headerCta.label}
          </Button>
        </div>
      </div>
    </div>
  </Container>

  {/* Deep blue behind the film so the band never flashes white before the poster arrives. */}
  <div class="relative mx-auto aspect-4/5 max-h-svh w-full max-w-cinema overflow-hidden bg-abyss-950 sm:aspect-video">
    {/* getImage + <picture> rather than <Picture>: the same srcsets must also feed the head preloads. */}
    <picture>
      <source
        media={PHONE_MEDIA}
        srcset={posterPortrait.srcSet.attribute}
        sizes="100vw"
        type="image/webp"
      />
      <img
        src={poster.src}
        srcset={poster.srcSet.attribute}
        sizes={sizes}
        width={poster.attributes['width']}
        height={poster.attributes['height']}
        alt="Dinar Super Wash, Detergent Powder and Detergent Cake packs among soap bubbles and splashes"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    </picture>
    <video
      data-js="hero-video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      disableRemotePlayback
      aria-hidden="true"
      tabindex="-1"
      class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-700 data-playing:opacity-100"
    >
      <source
        src={heroWebmPortrait}
        type='video/webm; codecs="av01.0.05M.08"'
        media={PHONE_MEDIA}
      />
      <source src={heroMp4Portrait} type='video/mp4; codecs="avc1.640020"' media={PHONE_MEDIA} />
      <source src={heroWebmSmall} type='video/webm; codecs="av01.0.05M.08"' media={SMALL_SCREEN} />
      <source src={heroMp4Small} type='video/mp4; codecs="avc1.64001F"' media={SMALL_SCREEN} />
      <source src={heroWebmLarge} type='video/webm; codecs="av01.0.08M.08"' />
      <source src={heroMp4Large} type='video/mp4; codecs="avc1.640032"' />
    </video>
  </div>
</section>

<script>
  import { initHeroVideo } from '@/scripts/hero-video';

  initHeroVideo();
</script>
