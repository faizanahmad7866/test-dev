---
/**
 * The brand's sign-off before the trade band: the client's "दिनार ही देना" wordmark, large and
 * centred on white, with the English line beneath set in the site's own type. The wordmark is
 * the heading, so its alt text is the slogan itself.
 */
import { Image } from 'astro:assets';
import wordmark from '@/assets/brand/dinar-hi-dena.png';
import Container from '@/components/ui/Container.astro';
import { site } from '@/config/site';
---

<section aria-labelledby="sign-off-title" class="py-14 lg:py-20">
  <Container class="reveal flex flex-col items-center text-center">
    <h2 id="sign-off-title">
      <Image
        src={wordmark}
        alt={site.slogans.hi}
        lang="hi"
        widths={[170, 228, 284, 340, 456, 568]}
        sizes="(min-width: 1024px) 284px, (min-width: 640px) 227px, 170px"
        class="h-24 w-auto sm:h-32 lg:h-40"
      />
    </h2>
    <p class="mt-6 text-xl font-bold tracking-tight text-navy-900 sm:text-2xl lg:text-3xl">
      {site.slogans.en}
    </p>
  </Container>
</section>
