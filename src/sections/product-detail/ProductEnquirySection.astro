---
/**
 * Product enquiry, after the safety panel and on the same 4 / 8 split: a short invitation on
 * the left, and on the right a navy panel naming the pack with its MRP, with the two ways to
 * ask about it. WhatsApp opens in a new tab with the pack already named in the message.
 * Dealers get a quieter link to the application, with this product preselected.
 */
import CatalogueDownloadLink from '@/components/catalogue/CatalogueDownloadLink.astro';
import Button from '@/components/ui/Button.astro';
import ArrowIcon from '@/components/ui/ArrowIcon.astro';
import Container from '@/components/ui/Container.astro';
import { site } from '@/config/site';
import { formatMrp } from '@/lib/format-mrp';
import { formatPhone } from '@/lib/format-phone';
import { buildProductEnquiryMessage } from '@/lib/product-enquiry';
import { skuName, type ProductSku } from '@/lib/product-skus';
import { buildWhatsAppUrl } from '@/lib/whatsapp';

interface Props {
  sku: ProductSku;
}

const { sku } = Astro.props;
const { product, variant } = sku;
const name = skuName(sku);
const whatsappHref = buildWhatsAppUrl(
  site.whatsappNumber,
  buildProductEnquiryMessage({ name, pack: variant.pack, mrp: variant.mrp }),
);
---

<section aria-labelledby="enquiry-title" class="pb-14 lg:pb-20">
  <Container class="reveal grid gap-6 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <p class="text-sm font-bold tracking-wide text-brand-700 uppercase">
        Enquiry{' '}
        <span lang="hi" class="ml-1 font-semibold tracking-normal normal-case">
          पूछताछ
        </span>
      </p>
      <h2
        id="enquiry-title"
        class="mt-2 text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl"
      >
        Questions about this product?
      </h2>
      <p class="mt-3 text-ink-600">Ask the Dinar team on WhatsApp, or call the helpline.</p>
    </div>

    <div class="rounded-2xl bg-navy-900 p-6 text-white sm:p-8 lg:col-span-8">
      <p class="text-sm text-white/60">You are asking about</p>
      <p class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span class="text-xl font-bold sm:text-2xl">{name}</span>
        <span class="text-white/70 tabular-nums">
          {variant.pack} · MRP {formatMrp(variant.mrp)}
        </span>
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={whatsappHref} variant="light" size="lg" newTab>
          Enquire on WhatsApp
        </Button>
        <Button href={`tel:${site.supportPhone}`} variant="outline" size="lg">
          Call {formatPhone(site.supportPhone)}
        </Button>
      </div>

      <div class="mt-6 flex flex-wrap gap-x-8">
        <a
          href={`/dealership/?product=${product.id}#application`}
          class="group inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-white/80 transition-colors hover:text-white"
        >
          Dealer or retailer? Apply to stock this product
          <ArrowIcon class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" />
        </a>
        <CatalogueDownloadLink class="text-sm text-white/80 hover:text-white" />
      </div>
    </div>
  </Container>
</section>
