---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import rangeStudio from '@/assets/brand/dinar-range-studio.jpg';
import TradeEnquirySection from '@/components/products/TradeEnquirySection.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listSkus } from '@/lib/product-skus';
import { buildProductListSchema } from '@/lib/schema/product-schema';
import ProductListSection from '@/sections/products/ProductListSection.astro';
import ProductsHeadSection from '@/sections/products/ProductsHeadSection.astro';

const BANNER_SIZES = '(min-width: 1152px) 1152px, 100vw';

const skus = listSkus(await getCollection('products'));
const banner = await getImage({
  src: rangeStudio,
  widths: [640, 960, 1376, 1920, 2400],
  format: 'webp',
});
const schema = buildProductListSchema(skus, site.url);
---

<BaseLayout
  title="Products"
  description="Dinar Super Wash, Dinar Detergent Powder and Dinar Detergent Cake. Every pack with its MRP, each with its own product page."
  image={rangeStudio}
  schema={schema}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={banner.srcSet.attribute}
    imagesizes={BANNER_SIZES}
    fetchpriority="high"
  />
  <ProductsHeadSection banner={banner} sizes={BANNER_SIZES} />
  <ProductListSection skus={skus} />
  <TradeEnquirySection />
</BaseLayout>
