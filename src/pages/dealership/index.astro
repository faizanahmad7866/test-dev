---
import { getCollection } from 'astro:content';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DealerApplicationSection from '@/sections/dealership/DealerApplicationSection.astro';
import DealershipHeadSection from '@/sections/dealership/DealershipHeadSection.astro';
import DealershipProcessSection from '@/sections/dealership/DealershipProcessSection.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const pageUrl = new URL(Astro.url.pathname, site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: 'Dealership', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Become a Dealer"
  description="Apply to become a Dinar dealer or distributor. Tell us about your business and the area you cover, and the Dinar team will get in touch."
  schema={schema}
>
  <DealershipHeadSection />
  <DealershipProcessSection />
  <DealerApplicationSection products={products} />
</BaseLayout>
